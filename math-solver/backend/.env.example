# OpenAI API Configuration
# Get your API key from: https://platform.openai.com/account/api-keys
OPENAI_API_KEY=your_openai_api_key_here

# Google Cloud Vision API (for OCR)
# Setup: https://cloud.google.com/vision/docs/setup
GOOGLE_CLOUD_VISION_API_KEY=your_google_cloud_vision_api_key_here

# Application Configuration
# Maximum file size in bytes (10MB default)
MAX_FILE_SIZE=10485760

# Allowed file types (comma-separated)
ALLOWED_FILE_TYPES=png,jpg,jpeg,gif,bmp,pdf,docx,doc,txt

# CORS Configuration
# Frontend URL for CORS settings
FRONTEND_URL=http://localhost:3000

# Jitsi Configuration (for screen sharing)
JITSI_DOMAIN=meet.jit.si

# Database Configuration (for future use)
DATABASE_URL=sqlite:///./math_solver.db

# Application Environment
ENVIRONMENT=development
DEBUG=true

# API Rate Limiting
RATE_LIMIT_REQUESTS=100
RATE_LIMIT_PERIOD=3600